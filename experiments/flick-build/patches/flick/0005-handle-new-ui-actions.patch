+                            for _ in 0..word_len {
+                                keyboard.input::<(), _>(
+                                    state,
+                                    backspace_keycode,
+                                    smithay::backend::input::KeyState::Pressed,
+                                    serial,
+                                    time,
+                                    |_, _, _| smithay::input::keyboard::FilterResult::Forward::<()>,
+                                );
+                                keyboard.input::<(), _>(
+                                    state,
+                                    backspace_keycode,
+                                    smithay::backend::input::KeyState::Released,
+                                    serial,
+                                    time,
