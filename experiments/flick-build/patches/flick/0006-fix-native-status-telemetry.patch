+fn read_trimmed(path: impl AsRef<Path>) -> Option<String> {
+    fs::read_to_string(path)
+        .ok()
+        .map(|s| s.trim().to_string())
+}
+
+fn find_battery_path_in(base: &Path) -> Option<PathBuf> {
+    let mut batteries = fs::read_dir(base)
+        .ok()?
+        .filter_map(Result::ok)
+        .map(|entry| entry.path())
+        .filter(|path| {
+            read_trimmed(path.join("type"))
+                .map(|value| value.eq_ignore_ascii_case("Battery"))
+                .unwrap_or(false)
+        })
+        .filter(|path| {
+            read_trimmed(path.join("present"))
+                .map(|value| value != "0")
+                .unwrap_or(true)
+        })
+        .filter(|path| path.join("capacity").is_file())
+        .collect::<Vec<_>>();
+
+    batteries.sort();
+    batteries.into_iter().next()
+}
+
+fn find_battery_path() -> Option<PathBuf> {
+    find_battery_path_in(Path::new("/sys/class/power_supply"))
+}
