#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOST="${VLENOVO_HOST:-10.230.221.139}"
USER_NAME="${VLENOVO_USER:-alex}"
REMOTE_DIR="${VLENOVO_REMOTE_DIR:-/home/${USER_NAME}/vlenovo-flick-dev}"
IDENTITY="${VLENOVO_IDENTITY:-$HOME/.ssh/id_ed25519}"
TARGET="${USER_NAME}@${HOST}"

SSH_OPTS=(
  -i "$IDENTITY"
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o ConnectTimeout=8
  -o ServerAliveInterval=15
  -o ServerAliveCountMax=4
  -o StrictHostKeyChecking=accept-new
)

ssh_tablet() {
  ssh "${SSH_OPTS[@]}" "$TARGET" "$@"
}

sync_repo() {
  echo "==> Syncing $ROOT -> $TARGET:$REMOTE_DIR"
  ssh_tablet "mkdir -p '$REMOTE_DIR' && rm -rf '$REMOTE_DIR/.git'"
  rsync -az --delete --delete-excluded     --exclude '.git'     --exclude 'result'     --exclude '.codegraph/'     --exclude 'debug/'     --exclude 'gpu-captures/'     -e "ssh -i '$IDENTITY' -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new"     "$ROOT/" "$TARGET:$REMOTE_DIR/"
}

remote_nix() {
  ssh "${SSH_OPTS[@]}" "$TARGET" "cd '$REMOTE_DIR' && $*"
}

usage() {
  cat <<'EOF'
Usage: ./bin/vlenovo-flick COMMAND

  ssh          Open an interactive tablet shell
  sync         Sync this branch to the tablet
  package      Build only packages.x86_64-linux.flick
  prebuild     Build Flick, then build the full NixOS generation
  test         Temporary nixos-rebuild test activation
  switch       Persist the already-validated generation
  rollback     Return runtime to /run/booted-system
  status       Show recovery-critical service state and generations
  hardware     Run the Flick hardware acceptance script
  logs         Show recent Flick/seatd/SXMO logs
  manual-drm   20-second bounded Flick DRM test; always restarts SXMO

The integration keeps services.flick.autostart=false until the DRM gate passes.
EOF
}

cmd="${1:-help}"
case "$cmd" in
  ssh)
    exec ssh "${SSH_OPTS[@]}" "$TARGET"
    ;;
  sync)
    sync_repo
    ;;
  package)
    sync_repo
    remote_nix "nix build .#packages.x86_64-linux.flick --no-link --print-out-paths -L"
    ;;
  prebuild)
    sync_repo
    remote_nix "nix build .#packages.x86_64-linux.flick --no-link --print-out-paths -L"
    remote_nix "sudo -n nixos-rebuild build --flake .#vlenovo --show-trace"
    ;;
  test)
    sync_repo
    remote_nix "sudo -n nixos-rebuild test --flake .#vlenovo --show-trace"
    ;;
  switch)
    sync_repo
    remote_nix "sudo -n nixos-rebuild switch --flake .#vlenovo --show-trace"
    ;;
  rollback)
    ssh -t "${SSH_OPTS[@]}" "$TARGET"       'sudo /run/booted-system/bin/switch-to-configuration test'
    ;;
  status)
    ssh_tablet '
      echo "CURRENT=$(readlink -f /run/current-system)"
      echo "BOOTED=$(readlink -f /run/booted-system)"
      echo
      systemctl --failed --no-pager
      echo
      systemctl is-active sshd NetworkManager sxmo bluetooth seatd 2>/dev/null || true
      echo
      command -v flick || true
      id
    '
    ;;
  hardware)
    sync_repo
    ssh_tablet "cd '$REMOTE_DIR' && bash tests/flick-hardware.sh"
    ;;
  logs)
    ssh_tablet 'journalctl -b -u flick -u seatd -u sxmo --no-pager -n 250'
    ;;
  manual-drm)
    sync_repo
    ssh -t "${SSH_OPTS[@]}" "$TARGET" "
      set -e
      cleanup() {
        sudo -n systemctl start sxmo.service || true
      }
      trap cleanup EXIT HUP INT TERM
      systemctl is-active sshd
      systemctl is-active NetworkManager
      systemctl is-active seatd
      command -v flick
      sudo -n systemctl stop sxmo.service
      sleep 2
      systemctl is-active sshd
      systemctl is-active NetworkManager
      sudo -n chvt 2 || true
      export XDG_RUNTIME_DIR=/run/user/\$(id -u)
      test -d "\$XDG_RUNTIME_DIR"
      export LIBSEAT_BACKEND=seatd
      export RUST_BACKTRACE=1
      export RUST_LOG=info,flick=debug
      timeout 20s flick --debug
    "
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
