+                                tracing::debug!("Slint {:?} element saved for switcher_elements", shell_view);
+                            } else {
+                                slint_elements.push(HomeRenderElement::Icon(slint_element));
+                                tracing::debug!("Slint {:?} element created and pushed", shell_view);
+                            }
+                        }
+                        Err(e) => {
+                            tracing::error!("Failed to create Slint render element: {:?}", e);
+                        }
+                    }
+                }            }
+
         } else {
