+                        Ok(vec![Rectangle::from_size((width as i32, height as i32).into())])
+                    });
+
+                    // Create render element
+                    let loc: smithay::utils::Point<i32, smithay::utils::Physical> = (0, 0).into();
+                    match MemoryRenderBufferRenderElement::from_buffer(
+                        renderer,
+                        loc.to_f64(),
+                        &mem_buffer,
+                        None,
+                        None,
+                        None,
+                        Kind::Unspecified,
+                    ) {
+                        Ok(slint_element) => {
