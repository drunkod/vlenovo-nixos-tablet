+                    let mut mem_buffer = MemoryRenderBuffer::new(
+                        Fourcc::Xbgr8888, // RGBX in little-endian - ignores 4th byte (alpha)
+                        (width as i32, height as i32),
+                        1, // scale
+                        Transform::Normal,
+                        None,
+                    );
+
+                    // Write pixels into buffer
